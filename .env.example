# Browser-safe public Supabase settings; use the project anon key, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GAME_API_URL=

# Server-only values must not use the VITE_ prefix.
# DATABASE_URL=  # Neon PostgreSQL; server/CI only
# SUPABASE_SERVICE_ROLE_KEY=  # server-only; never expose to browser
